rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function normalizedTokenEmail() {
      return request.auth.token.email.lower();
    }

    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_emails/$(normalizedTokenEmail()))
        && get(/databases/$(database)/documents/admin_emails/$(normalizedTokenEmail())).data.enabled == true;
    }

    function isOwnerOrAdmin(userId) {
      return request.auth != null
        && (request.auth.uid == userId || isAuthorizedAdmin());
    }

    function isValidUserProfileData(data) {
      return data.keys().size() <= 30
        && (!('pseudo' in data) || (data.pseudo is string && data.pseudo.size() <= 40))
        && (!('email' in data) || (data.email == null || (data.email is string && data.email.size() <= 254)))
        && (!('currentCity' in data) || (data.currentCity is string && data.currentCity.size() <= 100))
        && (!('currentZone' in data) || (data.currentZone is string && data.currentZone.size() <= 40))
        && (!('characterId' in data) || (data.characterId is string && data.characterId.size() <= 40))
        && (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 10000000))
        && (!('activeCompanions' in data) || (data.activeCompanions is list && data.activeCompanions.size() <= 4))
        && (!('unlockedCompanions' in data) || (data.unlockedCompanions is list && data.unlockedCompanions.size() <= 50))
        && (!('unlockedItems' in data) || (data.unlockedItems is list && data.unlockedItems.size() <= 200))
        && (!('unlockedCharacters' in data) || (data.unlockedCharacters is list && data.unlockedCharacters.size() <= 30))
        && (!('inTransit' in data) || data.inTransit is bool)
        && (!('transitRemainingMinutes' in data) || (data.transitRemainingMinutes is int && data.transitRemainingMinutes >= 0 && data.transitRemainingMinutes <= 100000))
        && (!('transitRoute' in data) || (data.transitRoute is list && data.transitRoute.size() <= 100));
    }

    function isAllowedUserSubcollection(subcollection) {
      return subcollection in [
        'travel',
        'travel_history',
        'visited_cities',
        'stopped_cities',
        'history'
      ];
    }

    function isValidSubcollectionDocument(data) {
      return data.keys().size() <= 20
        && (!('durationMinutes' in data) || (data.durationMinutes is int && data.durationMinutes >= -1 && data.durationMinutes <= 100000))
        && (!('midRouteProgress' in data) || (data.midRouteProgress is int && data.midRouteProgress >= 0 && data.midRouteProgress <= 100000))
        && (!('plannedRoute' in data) || (data.plannedRoute is list && data.plannedRoute.size() <= 100))
        && (!('isFocusActive' in data) || data.isFocusActive is bool)
        && (!('isCompleted' in data) || data.isCompleted is bool)
        && (!('isFailed' in data) || data.isFailed is bool);
    }

    match /users/{userId} {
      allow read, delete: if isOwnerOrAdmin(userId);
      allow create, update: if isOwnerOrAdmin(userId)
        && isValidUserProfileData(request.resource.data);

      match /{subcollection}/{docId} {
        allow read, delete: if isOwnerOrAdmin(userId)
          && isAllowedUserSubcollection(subcollection);
        allow create, update: if isOwnerOrAdmin(userId)
          && isAllowedUserSubcollection(subcollection)
          && isValidSubcollectionDocument(request.resource.data);
      }
    }

    match /admin_emails/{email} {
      allow get: if isAuthorizedAdmin()
        || (request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email_verified == true
          && normalizedTokenEmail() == email.lower());
      allow list: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin()
        && email == email.lower()
        && email != normalizedTokenEmail()
        && request.resource.data.keys().size() <= 6
        && request.resource.data.enabled is bool;
      allow delete: if isAuthorizedAdmin()
        && email == email.lower()
        && email != normalizedTokenEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
