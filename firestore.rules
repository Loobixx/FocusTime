rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)).data.enabled == true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || isAuthorizedAdmin());
    }

    match /admin_emails/{email} {
      allow get: if isAuthorizedAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == email);
      allow list: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin()
        && email != request.auth.token.email
        && request.resource.data.enabled is bool;
      allow delete: if isAuthorizedAdmin()
        && email != request.auth.token.email;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
