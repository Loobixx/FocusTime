rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)).data.enabled == true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || isAuthorizedAdmin());
    }

    match /admin_emails/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
